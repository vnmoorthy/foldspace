<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  FOLDSPACE sponsor-tool credentials (Supabase · OpenAI · Sentry).

	  1. Copy this file to Foldspace/Secrets.plist  (that path is gitignored — never commit it)
	  2. Fill in the values you have. Every key may stay empty: the game runs fully offline.
	  3. Run `xcodegen generate` once so Xcode picks up the new resource.

	  Foldspace/Config/Secrets.swift reads Secrets.plist first and falls back to this file.
	  A FOLDSPACE_<KEY> environment variable (Xcode scheme → Run → Arguments) overrides either.
	-->

	<!-- Supabase → Project Settings → API → Project URL, e.g. https://abcdefgh.supabase.co -->
	<key>SUPABASE_URL</key>
	<string></string>

	<!-- Supabase → Project Settings → API → Project API keys → anon (public) -->
	<key>SUPABASE_ANON_KEY</key>
	<string></string>

	<!-- platform.openai.com → API keys (an API key, not a ChatGPT subscription) -->
	<key>OPENAI_API_KEY</key>
	<string></string>

	<!-- Chat-completions model id. Empty = "gpt-5-mini". -->
	<key>OPENAI_MODEL</key>
	<string></string>

	<!-- sentry.io → Project → Settings → Client Keys (DSN) -->
	<key>SENTRY_DSN</key>
	<string></string>
</dict>
</plist>
